          },
          "slug": "h1",
          "name": "H1"
        },
        {
          "size": "45px",
          "fluid": {
            "min": "33px",
            "max": "45px"
          },
          "slug": "h2",
          "name": "H2"
        },
        {
          "size": "24px",
          "fluid": {
            "min": "22px",
            "max": "24px"
          },
          "slug": "h3",
          "name": "H3"
        }
      ]
