        {
          "name": "Small",
          "slug": "small",
          "shadow": "0px 0px 20px 0px rgba(0, 0, 0, 0.20);"
        },
        {
          "name": "Medium",
          "slug": "medium",
          "shadow": "0px 4px 15px 5px rgba(38, 38, 43, 0.15)"
