      "padding": true,
      "margin": true,
      "spacingScale": {
        "steps": 0
      },
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "name": "3",
          "size": "clamp(0.75rem, 0.4947rem + 0.7092vw, 1rem)",
          "slug": "30"
        },
        {
          "name": "4",
          "size": "clamp(1.5rem, 0.9894rem + 1.4184vw, 2rem)",
          "slug": "40"
        },
        {
          "name": "5",
          "size": "clamp(2rem, 0.9787rem + 2.8369vw, 3rem)",
          "slug": "50"
        },
        {
          "name": "6",
          "size": "clamp(2.25rem, 0.4628rem + 4.9645vw, 4rem)",
          "slug": "60"
        },
        {
          "name": "7",
          "size": "clamp(4rem, 1.9574rem + 5.6738vw, 6rem)",
          "slug": "70"
        },
        {
          "name": "8",
          "size": "clamp(5.25rem, 2.9521rem + 6.383vw, 7.5rem)",
          "slug": "80"
        },
        {
