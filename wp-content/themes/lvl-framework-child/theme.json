    "blocks": {
      "core/paragraph": {
        "spacing": {
          "margin": true
        },
        "color": {
          "text": true,
          "background": true,
          "link": true
        }
      },
      "core/button": {
        "border": {
          "radius": false,
          "width": false
        }
      }
    }
